<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ScpSlPanel.LabApiBridge</AssemblyName>
    <RootNamespace>ScpSlPanel.LabApiBridge</RootNamespace>
    <ScpSlManagedPath Condition="'$(ScpSlManagedPath)' == ''">$(SCPSL_MANAGED)</ScpSlManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="LabApi" HintPath="$(ScpSlManagedPath)\LabApi.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ScpSlManagedPath)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <Target Name="ValidateScpSlReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ScpSlManagedPath)' == ''" Text="Set SCPSL_MANAGED to the SCP Secret Laboratory\SCPSL_Data\Managed directory." />
    <Error Condition="!Exists('$(ScpSlManagedPath)\LabApi.dll')" Text="LabApi.dll was not found in $(ScpSlManagedPath)." />
    <Error Condition="!Exists('$(ScpSlManagedPath)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found in $(ScpSlManagedPath)." />
  </Target>
</Project>
