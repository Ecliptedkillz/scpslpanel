# Copy this file to .env and replace every placeholder.
Panel__BootstrapUsername=admin
Panel__BootstrapPassword=replace-with-a-long-random-password
Panel__DiscordOAuth__ClientId=your-discord-application-id
Panel__DiscordOAuth__ClientSecret=your-discord-client-secret
Panel__Backups__Enabled=true
Panel__Backups__Retention=14
# Leave empty to store recovery archives under the panel data directory.
Panel__Backups__Path=
